{
	"name": "regap-workspace",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "3.9.6",
		"turbo": "^2.11.2",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=24"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx}": [
			"biome check --write"
		]
	}
}
